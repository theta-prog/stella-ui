{
  "name": "@stella-ds/theme",
  "version": "0.8.0",
  "description": "Stella UI design tokens – framework-agnostic CSS variables and JSON",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theta-prog/stella-ds.git",
    "directory": "packages/theme"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": "./src/tokens.json",
    "./css": "./dist/tokens.css",
    "./tailwind": {
      "require": "./dist/tailwind-preset.cjs",
      "import": "./dist/tailwind-preset.mjs"
    },
    "./tailwind-v4": "./dist/tailwind-v4.css"
  },
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist && node scripts/build-css.js && node scripts/build-tailwind.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
